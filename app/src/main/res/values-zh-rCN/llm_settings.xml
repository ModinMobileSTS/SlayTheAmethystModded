<resources>
    <string name="llm_tutorial_title">配置教程</string>
    <string name="llm_tutorial_entry_hint">按步骤获取密钥、添加模型并测试连接</string>
    <string name="llm_battery_exemption_title">保持后台运行</string>
    <string name="llm_battery_exemption_summary">点击关闭电池优化，避免工作中断。</string>
    <string name="llm_battery_exemption_granted">点击开启电池优化，节省电量。</string>
    <string name="llm_tutorial_provider_deepseek">DeepSeek</string>
    <string name="llm_tutorial_provider_siliconflow">硅基流动</string>
    <string name="llm_tutorial_provider_agentrouter">AgentRouter</string>
    <string name="llm_tutorial_provider_aihub">AIHub</string>
    <string name="llm_tutorial_provider_aihub_desc">可以调用GPT系列的顶级模型，按量计费，无须实名，模型很聪明，额度消耗速度和 DeepSeek 官方差不多</string>
    <string name="llm_tutorial_aihub_intro">注册 AIHub 并充值后，在控制台创建令牌即可取得 API Key。地址、密钥和模型 ID 都来自 AIHub。</string>
    <string name="llm_tutorial_aihub_register_title">1. 注册账号</string>
    <string name="llm_tutorial_aihub_register_step">通过下面的邀请链接注册（可复制）。</string>
    <string name="llm_tutorial_aihub_wallet_title">2. 充值额度</string>
    <string name="llm_tutorial_aihub_wallet_step">打开侧边栏的“钱包管理”，按需充值，初次使用可以先充少量额度。</string>
    <string name="llm_tutorial_aihub_token_title">3. 创建并复制 API 令牌</string>
    <string name="llm_tutorial_aihub_token_entry_step">在控制台侧边栏找到“令牌管理”。</string>
    <string name="llm_tutorial_aihub_token_action_step">点击“显示操作项”，然后点击“添加令牌”。</string>
    <string name="llm_tutorial_aihub_token_form_step">随便输入一个名称，按照预算选择分组。一般越贵的分组越稳定，预算充足可以选择“超级满血渠道”，然后提交。</string>
    <string name="llm_tutorial_aihub_token_copy_step">创建后点击密钥旁的复制按钮，复制 API Key 并保存。</string>
    <string name="llm_tutorial_aihub_image_wallet">侧边栏的钱包管理入口及充值额度选项</string>
    <string name="llm_tutorial_aihub_image_token_entry">控制台侧边栏的令牌管理入口</string>
    <string name="llm_tutorial_aihub_image_token_action">令牌管理页面的操作项与添加令牌按钮</string>
    <string name="llm_tutorial_aihub_image_token_form">填写令牌名称并按预算选择 GPT 分组</string>
    <string name="llm_tutorial_aihub_image_token_copy">令牌详情中的密钥复制按钮</string>
    <string name="llm_tutorial_provider_deepseek_desc">服务快速稳定，按量计费，长期使用略贵</string>
    <string name="llm_tutorial_provider_siliconflow_desc">服务略慢于 DeepSeek，有 18 元免费额度，适合体验或做一些小功能，比较耐用</string>
    <string name="llm_tutorial_provider_agentrouter_desc">大模型第三方中转站，稳定性不能保证，但可以用 GPT 等顶级模型，每天签到送额度\n需要2025.11 前注册的 github 账号，不建议新手使用</string>
    <string name="llm_tutorial_tag_official">官方</string>
    <string name="llm_tutorial_tag_pay_as_you_go">按量计费</string>
    <string name="llm_tutorial_tag_no_verification">无须实名</string>
    <string name="llm_tutorial_tag_free_quota">免费额度</string>
    <string name="llm_tutorial_tag_verification">实名认证</string>
    <string name="llm_tutorial_tag_requires_vpn">需要魔法</string>
    <string name="llm_tutorial_intro_title">开始之前</string>
    <string name="llm_tutorial_intro">地址、密钥和模型 ID 都来自 DeepSeek；Base URL 与密钥需配套使用。</string>
    <string name="llm_tutorial_key_title">1. 申请 API Key</string>
    <string name="llm_tutorial_key_step">打开申请地址 → 创建 API key（名称自定）→ 复制密钥并保存。关闭弹窗后无法再次查看完整密钥。</string>
    <string name="llm_tutorial_copy_link">复制申请地址</string>
    <string name="llm_tutorial_open_link">打开网页</string>
    <string name="llm_tutorial_key_warning">API Key 请勿分享或公开。</string>
    <string name="llm_tutorial_config_title">%1$d. 填写服务连接和凭证</string>
    <string name="llm_tutorial_config_step">返回设置，在“服务连接”中填写 Base URL：</string>
    <string name="llm_tutorial_copy_base_url">复制 Base URL</string>
    <string name="llm_tutorial_config_key">把密钥粘贴到“凭证”中的 API Key；以后留空即保留已有密钥。</string>
    <string name="llm_tutorial_models_title">%1$d. 获取并选择模型</string>
    <string name="llm_tutorial_models_step">“管理模型”→“从上游获取”→选中模型→“完成”。获取失败时，可用“新增自定义模型”填写厂商提供的模型 ID。</string>
    <string name="llm_tutorial_test_title">%1$d. 测试连接</string>
    <string name="llm_tutorial_test_step">点击“测试模型”，有响应即成功。失败时检查地址、密钥、模型 ID、账户额度和网络。</string>
    <string name="llm_tutorial_edit_title">%1$d. 开始编辑</string>
    <string name="llm_tutorial_edit_step">在模组卡片上点击编辑模组即可使用 AI 编辑模组</string>
    <string name="llm_tutorial_sf_intro">硅基流动带免费额度，注册并完成实名认证后即可创建 API 密钥。地址、密钥和模型 ID 都来自硅基流动。</string>
    <string name="llm_tutorial_sf_account_title">1. 注册并实名认证</string>
    <string name="llm_tutorial_sf_account_step">通过下面的邀请链接注册（有样式，可复制）。</string>
    <string name="llm_tutorial_sf_verify_step">注册后完成实名认证：左侧“账户管理”→“实名认证”，按提示提交。</string>
    <string name="llm_tutorial_sf_key_title">2. 创建并复制 API 密钥</string>
    <string name="llm_tutorial_sf_key_step">“API 密钥”→“新建 API 密钥”→ 描述随意填写 →“新建密钥”→ 点击密钥后选择“复制”。</string>
    <string name="llm_tutorial_sf_image_verify">账户管理中的实名认证入口</string>
    <string name="llm_tutorial_sf_image_key_entry">侧边栏中的 API 密钥入口</string>
    <string name="llm_tutorial_sf_image_key_create">API 密钥页面的新建 API 密钥按钮</string>
    <string name="llm_tutorial_sf_image_key_desc">新建密钥弹窗，描述可随意填写</string>
    <string name="llm_tutorial_sf_image_key_copy">点击密钥后选择复制的操作菜单</string>
    <string name="llm_tutorial_ar_intro">AgentRouter 是 OpenAI 兼容的 API 网关，注册后在控制台创建令牌即可拿到 API Key。地址、密钥和模型 ID 都来自 AgentRouter。</string>
    <string name="llm_tutorial_ar_register_title">1. 注册账号</string>
    <string name="llm_tutorial_ar_register_step">通过下面的邀请链接注册（可复制）。</string>
    <string name="llm_tutorial_ar_token_title">2. 创建并复制 API 令牌</string>
    <string name="llm_tutorial_ar_token_step">控制台 →“API 令牌”→“添加令牌”→ 随便输入个名字 →“提交”→ 复制生成的 API key。</string>
    <string name="llm_tutorial_ar_responses_title">5. 切换到 Responses API</string>
    <string name="llm_tutorial_ar_responses_step">在设置的“请求选项”中，点击“接口协议”，切换为“Responses”，再测试连接。</string>
