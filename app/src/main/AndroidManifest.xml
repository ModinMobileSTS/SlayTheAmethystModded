<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="top.apricityx.workshop" />
        <package android:name="com.valvesoftware.android.steam.community" />
    </queries>

    <application
        android:name="io.stamethyst.StsApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:isGame="true"
        android:allowNativeHeapPointerTagging="false"
        android:icon="@mipmap/ic_launcher_amethyst"
        android:label="Slay the Amethyst"
        android:roundIcon="@mipmap/ic_launcher_amethyst_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SlayTheAmethyst"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />
        <meta-data
            android:name="com.android.app.gamemode.performance.enabled"
            android:value="true" />
        <meta-data
            android:name="com.android.app.gamemode.battery.enabled"
            android:value="true" />

        <!-- Keep the launch window portrait for Godot; the inherited session switches to
             landscape only after saved/entry, or when recovering from a minigame failure. -->
        <activity
            android:name="io.stamethyst.GodotBootGameActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:hardwareAccelerated="true"
            android:process=":game"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SlayTheAmethyst.Game.GodotBoot" />

        <activity
            android:name="io.stamethyst.StsGameActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:hardwareAccelerated="true"
            android:process=":game"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.SlayTheAmethyst.Game"
            tools:targetApi="33">

            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="720dp"
                android:minWidth="640dp"
                android:minHeight="360dp"
                android:gravity="center" />
        </activity>

        <activity
            android:name="io.stamethyst.SlingBreakActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SlayTheAmethyst" />

        <activity
            android:name="io.stamethyst.backend.file_interactive.SafExportActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.SlayTheAmethyst.Dialog" />

        <activity
            android:name="io.stamethyst.ui.refresh.RefreshRateDiagnosticsActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.SlayTheAmethyst" />

        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:screenOrientation="fullUser"
            android:theme="@style/Base.Theme.AppCompat" />

        <service
            android:name="io.stamethyst.backend.diag.DiagnosticsProcessService"
            android:exported="false"
            android:process=":diag" />

        <!-- Runs the AI patch smoke test's game session with no window and no display. It lives in
             :game because that is the process the game JVM is loaded into. It is only ever bound
             (never started), so no foreground-service notification is required. -->
        <service
            android:name="io.stamethyst.backend.launch.AgentPatchSmokeTestService"
            android:exported="false"
            android:process=":game" />

        <!-- Exported receiver so adb can trigger DiagnosticsProcessService
             without the service itself being exported. -->
        <receiver
            android:name="io.stamethyst.backend.diag.AdbDiagnosticsReceiver"
            android:exported="true"
            android:process=":diag">
            <intent-filter>
                <action android:name="io.stamethyst.action.ADB_STAGE_JVM_LOG" />
            </intent-filter>
        </receiver>

        <!-- Debug-only adb entry point for the AI patch smoke test. Runs in the launcher process,
             which the smoke test requires, and does nothing in a release build. -->
        <receiver
            android:name="io.stamethyst.backend.mods.AgentPatchSmokeTestAdbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.stamethyst.action.RUN_AGENT_PATCH_SMOKE_TEST" />
            </intent-filter>
        </receiver>

        <service
            android:name="io.stamethyst.backend.diag.LogcatCaptureService"
            android:exported="false"
            android:process=":logcat" />

        <service
            android:name="io.stamethyst.backend.diag.LauncherLogcatCaptureService"
            android:exported="false"
            android:process=":logcat" />

        <service
            android:name="io.stamethyst.backend.workshop.WorkshopDownloadProcessService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="io.stamethyst.ui.aimod.AiAgentExecutionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="io.stamethyst.backend.steamcloud.SteamCloudSyncProcessService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":steamcloud" />

        <service
            android:name="io.stamethyst.backend.steamcloud.SteamGamePresenceService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":game" />

        <provider
            android:name="io.stamethyst.backend.easytier.EasyTierCredentialProvider"
            android:authorities="${applicationId}.easytier.credentials"
            android:exported="false"
            android:process=":easytier" />

        <service
            android:name="io.stamethyst.backend.easytier.EasyTierProcessService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":easytier" />

        <service
            android:name="io.stamethyst.backend.easytier.StsEasyTierVpnService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:process=":easytier"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <activity
            android:name="net.kdt.pojavlaunch.ExitActivity"
            android:exported="false"
            android:theme="@style/Theme.SlayTheAmethyst.Dialog" />

        <!-- Read legacy browser storage only in the process that owns that WebView profile. -->
        <service android:name="io.stamethyst.godot.LegacySlingBreakSaveService"
            android:exported="false" />
        <service android:name="io.stamethyst.godot.LegacySlingBreakSaveService$GameProcess"
            android:exported="false" android:process=":game" />

        <activity android:name="io.stamethyst.godot.GodotMinigameActivity"
            android:exported="false" android:process=":minigame"
            android:enableOnBackInvokedCallback="false"
            android:screenOrientation="portrait" android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:theme="@style/GodotPrototypeWindow" />

        <activity
            android:name="io.stamethyst.LauncherActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="fullUser"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-java-archive" />
                <data android:mimeType="application/jar" />
                <data android:mimeType="application/x-jar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-java-archive" />
                <data android:mimeType="application/jar" />
                <data android:mimeType="application/x-jar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-java-archive" />
                <data android:mimeType="application/jar" />
                <data android:mimeType="application/x-jar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherActivityIconAmethyst"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amethyst"
            android:label="Slay the Amethyst"
            android:roundIcon="@mipmap/ic_launcher_amethyst_round"
            android:targetActivity="io.stamethyst.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherActivityIconWatcher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_watcher"
            android:label="Slay the Amethyst"
            android:roundIcon="@mipmap/ic_launcher_watcher_round"
            android:targetActivity="io.stamethyst.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
